{
    // See https://go.microsoft.com/fwlink/?LinkId=733558 
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FileCopy - Driver",
            "type": "shell",
			"group": "build",
            "command": "npm run fileCopy",
			"options": {
				"cwd": "./" 
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared",
			}
        },
        {
            "label": "Install Dependencies - All",
			"group": "build",
			"dependsOn": [
				"Install Dependencies - dotnet-t4",
				"Install Dependencies - npm"
			]
        },
        {
            "label": "Install Dependencies - dotnet-t4",
            "type": "shell",
            "command": "dotnet tool install --global dotnet-t4 --version 3.0.0",
        },
        {
            "label": "Install Dependencies - npm",
            "type": "shell",
            "command": "npm install"
        },
        {
            "label": "Typescript Build",
            "type": "typescript",
            "tsconfig": "tsconfig.json",
            "problemMatcher": [
                "$tsc"
            ],
            "group": "build"
        },
        {
            "label": "Render T4 Templates",
            "type": "shell",
            "command": "t4 ConfigSettings.tt -o ConfigSettings.xml && t4 DeviceDescription.tt -o DeviceDescription.xml && t4 SystemEvents.tt -o SystemEvents.xml && t4 SystemFunctions.tt -o SystemFunctions.xml && t4 SystemVariables.tt -o SystemVariables.xml",
            "options": {
                "cwd": ".\\configuration"
            },
            "group": "build"
        },
        {
            "label": "Package Driver",
            "type": "shell",
            "command": "..\\tools\\PackageDriver.exe",
            "options": {
                "cwd": ".\\dist"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "Render T4 Templates",
                "Typescript Build",
                "Uglify Javascript",
				"FileCopy - Driver"
            ]
        },
        {
            "label": "Uglify Javascript",
            "type": "shell",
            "command": "npm run uglify",
        }
    ]
}